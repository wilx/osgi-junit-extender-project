<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>example.junit</groupId>
    <artifactId>osgi-junit-extender-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>fixture-tests-fragment</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.apache.servicemix.bundles</groupId>
      <artifactId>org.apache.servicemix.bundles.junit</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>example.junit</groupId>
      <artifactId>fixture-production</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <configuration>
          <instructions>
            <Bundle-SymbolicName>example.fixture.tests</Bundle-SymbolicName>
            <Fragment-Host>example.fixture.production;bundle-version="[1.0.0,3.0.0)"</Fragment-Host>
            <Require-Capability>junit;effective:=active</Require-Capability>
            <Import-Package>!java.*,!org.junit,!org.junit.*,!junit,!junit.*,!org.hamcrest,!org.hamcrest.*,*</Import-Package>
          </instructions>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>${project.build.directory}/osgi-manifest/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
